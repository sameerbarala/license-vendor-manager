### 1. Get all vendors
GET http://localhost:8080/api/vendors

### 2. Create a vendor
POST http://localhost:8080/api/vendors
Content-Type: application/json

{
  "name": "Microsoft",
  "email": "sales@microsoft.com",
  "category": "Software",
  "status": "Active"
}

### 3. Create a second vendor
POST http://localhost:8080/api/vendors
Content-Type: application/json

{
  "name": "Oracle",
  "email": "contact@oracle.com",
  "category": "Cloud",
  "status": "Inactive"
}

### 4. Get one vendor
GET http://localhost:8080/api/vendors/1

### 5. Update vendor 2
PUT http://localhost:8080/api/vendors/2
Content-Type: application/json

{
  "name": "Oracle",
  "email": "contact@oracle.com",
  "category": "Cloud",
  "status": "Active"
}

### 6. Invalid: empty name (expect 400)
POST http://localhost:8080/api/vendors
Content-Type: application/json

{
  "name": "",
  "email": "x@y.com",
  "category": "Other",
  "status": "Active"
}

### 7. Invalid: duplicate name (expect 400)
POST http://localhost:8080/api/vendors
Content-Type: application/json

{
  "name": "microsoft",
  "email": "other@microsoft.com",
  "category": "Software",
  "status": "Active"
}

### 8. Delete vendor 1
DELETE http://localhost:8080/api/vendors/1

### 9. Get a missing vendor (expect 404)
GET http://localhost:8080/api/vendors/999

############ LICENSES ############

### L1. Get all licenses
GET http://localhost:8080/api/licenses

### L2. Create a subscription license (change vendorId to a real one)
POST http://localhost:8080/api/licenses
Content-Type: application/json

{
  "name": "Microsoft 365 Business",
  "licenseType": "Subscription",
  "seats": 25,
  "cost": 3125.50,
  "expiryDate": "2027-03-31",
  "vendorId": 5
}

### L3. Create a perpetual license (no expiry date needed)
POST http://localhost:8080/api/licenses
Content-Type: application/json

{
  "name": "Visual Studio Professional",
  "licenseType": "Perpetual",
  "seats": 5,
  "cost": 1200,
  "vendorId": 5
}

### L4. Update license 1 (change seats)
PUT http://localhost:8080/api/licenses/3
Content-Type: application/json

{
  "name": "Microsoft 365 Business",
  "licenseType": "Subscription",
  "seats": 40,
  "cost": 5000,
  "expiryDate": "2027-03-31",
  "vendorId": 4
}

### L5. Invalid: vendor does not exist (expect 400)
POST http://localhost:8080/api/licenses
Content-Type: application/json

{
  "name": "Ghost License",
  "licenseType": "Trial",
  "seats": 1,
  "cost": 0,
  "expiryDate": "2027-01-01",
  "vendorId": 9999
}

### L6. Invalid: subscription without expiry date (expect 400)
POST http://localhost:8080/api/licenses
Content-Type: application/json

{
  "name": "No Expiry",
  "licenseType": "Subscription",
  "seats": 1,
  "cost": 10,
  "vendorId": 4
}

### L7. Invalid: zero seats (expect 400)
POST http://localhost:8080/api/licenses
Content-Type: application/json

{
  "name": "Zero Seats",
  "licenseType": "Trial",
  "seats": 0,
  "cost": 10,
  "expiryDate": "2027-01-01",
  "vendorId": 4
}

### L8. Delete license 1
DELETE http://localhost:8080/api/licenses/3

### L9. Missing license (expect 404)
GET http://localhost:8080/api/licenses/999

############ STEP 10 TESTS ############

### S1. Vendor with everything wrong (expect 400, several messages)
POST http://localhost:8080/api/vendors
Content-Type: application/json

{ "name": "", "email": "abc", "category": "", "status": "Maybe" }

### S2. Vendor with an unusual status (expect 400)
POST http://localhost:8080/api/vendors
Content-Type: application/json

{ "name": "TestCo", "email": "a@b.com", "category": "Other", "status": "Maybe" }

### S3. Duplicate vendor name (expect 409; use an existing name)
POST http://localhost:8080/api/vendors
Content-Type: application/json

{ "name": "Figma", "email": "x@y.com", "category": "Software", "status": "Active" }

### S4. Missing vendor (expect 404)
GET http://localhost:8080/api/vendors/9999

### S5. License with bad fields (expect 400)
POST http://localhost:8080/api/licenses
Content-Type: application/json

{ "name": "", "licenseType": "Lifetime", "seats": 0, "cost": -5, "vendorId": YOUR_ID }

### S6. License with a badly formatted date (expect 400)
POST http://localhost:8080/api/licenses
Content-Type: application/json

{ "name": "Bad Date", "licenseType": "Trial", "seats": 1, "cost": 0, "expiryDate": "31-12-2027", "vendorId": YOUR_ID }

### S7. Subscription without expiry (expect 400)
POST http://localhost:8080/api/licenses
Content-Type: application/json

{ "name": "No Expiry", "licenseType": "Subscription", "seats": 1, "cost": 10, "vendorId": YOUR_ID }

### S8. Unknown vendor (expect 400, "Vendor not found.")
POST http://localhost:8080/api/licenses
Content-Type: application/json

{ "name": "Ghost", "licenseType": "Trial", "seats": 1, "cost": 0, "expiryDate": "2027-01-01", "vendorId": 9999 }

### S9. A valid license (expect 201)
POST http://localhost:8080/api/licenses
Content-Type: application/json

{ "name": "Refactor Check", "licenseType": "Subscription", "seats": 3, "cost": 99.5, "expiryDate": "2027-06-30", "vendorId": YOUR_ID }

### V-DEL. Delete a vendor that has licenses (expect 409)
DELETE http://localhost:8080/api/vendors/7